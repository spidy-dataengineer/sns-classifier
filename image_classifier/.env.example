# ============================================================
# image_classifier 환경변수
# 사용법: 이 파일을 .env 로 복사하고 키를 채우세요.
#   PowerShell:  Copy-Item .env.example .env
# ============================================================

# --- Gemini (기본 백엔드) ---
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=여기에-발급받은-키-붙여넣기
# 모델 백업 체인 (콤마구분, 앞에서부터 시도; 한도 소진/불가 시 자동으로 다음 모델로 전환).
# 미설정 시 코드 기본 체인 사용. 무료 quota는 모델마다 별도라 여러 개 두면 무료로 더 많이 처리됨.
GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-3-flash-preview,gemini-3.5-flash,gemini-3.1-flash-lite

# --- Claude (보조 백엔드, --backend claude 일 때만 필요) ---
# 발급: https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_VISION_MODEL=claude-opus-4-8
